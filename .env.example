# Muse runtime
FASHION_AGENT_RUNTIME=muse
FASHION_AGENT_LLM_PROVIDER=openai

# OpenAI brain, vision, and image providers
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_TOOL_HOST_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=

# Included wardrobe fixture and canonical product images
FASHION_AGENT_CLOSET_PROVIDER=local
FASHION_AGENT_CLOSET_DATA=./data/demo2-wardrobe/wardrobe.json
FASHION_AGENT_CLOSET_PRESENTATION_METADATA=./data/demo2-presentation-metadata.json
FASHION_AGENT_DEMO2_PRODUCT_IMAGE_DIR=./data/demo2-product-images

# Capability providers
FASHION_AGENT_VISION_PROVIDER=openai
FASHION_AGENT_IMAGE_PROVIDER=openai
FASHION_AGENT_WEATHER_PROVIDER=mock
FASHION_AGENT_PRODUCT_PROVIDER=disabled
FASHION_AGENT_MOCK_TOOLS=false

# Mirror and local persistence
FASHION_AGENT_VISUAL_CACHE_TTL_MS=10000
FASHION_AGENT_MIRROR_FRAME_INTERVAL_MS=6000
FASHION_AGENT_INPUT_DIR=./examples
FASHION_AGENT_OUTPUT_DIR=./out
FASHION_AGENT_MEMORY_DATA=./out/muse-memory-v1.json
FASHION_AGENT_SKILLS_DIR=./skills
FASHION_AGENT_TRACE=false

# Demo default. Turn on when you want visual quality gates to block artifacts.
FASHION_AGENT_VISUAL_QC=false

# Optional legacy Ollama/Gemma path
GEMMA4_OLLAMA_ENDPOINT=http://127.0.0.1:18034
GEMMA4_OLLAMA_MODEL=gemma4:26b
FASHION_AGENT_GEMMA4_AUTO_TUNNEL=false
