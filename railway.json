{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm --prefix web ci && npm run web:build && npm run build"
  },
  "deploy": {
    "startCommand": "node dist/server/webServer.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
